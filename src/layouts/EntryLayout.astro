---
// Shared layout for a single blog post or project write-up.
import BaseLayout from './BaseLayout.astro';
import { formatDate, url } from '@/utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  meta?: string;
  back: { href: string; label: string };
}
const { title, description, date, updated, tags = [], meta, back } = Astro.props;
---
<BaseLayout title={title} description={description} type="article">
  <article>
    <header class="page-head">
      <a class="small mono" href={url(back.href)}>← {back.label}</a>
      <h1>{title}</h1>
      <p class="mono small">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <> · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {meta && <> · {meta}</>}
      </p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
      <slot name="actions" />
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
