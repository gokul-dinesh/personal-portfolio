---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import PostList from '@/components/PostList.astro';
import InTheLab from '@/components/InTheLab.astro';
import { SITE } from '@/config';
import { getPosts, getProjects, url } from '@/utils';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const posts = (await getPosts()).slice(0, 5);
---
<BaseLayout>
  <section class="hero">
    <p class="mono prompt"><span>$</span> whoami</p>
    <h1>Hi, I'm {SITE.name}.</h1>
    <p class="mono small tagline">{SITE.tagline}</p>
    <p class="lead">
      I'm a software engineer who recently finished a Master of Computing in <strong>Artificial Intelligence</strong> at ANU.
      I build full-stack products end to end, most recently <a href="https://bardar.online">Bardar</a>, a live
      artist discovery platform, and <strong>PoliRec</strong>, an Android app with an integrated AI assistant.
      On the AI side I've built a <a href={url('projects/multidrone/')}>multi-drone motion planner</a> (RRT-Connect in 3D).
      I daily-drive Linux and like knowing how things work under the hood.
    </p>
    <p class="meta small mono">
      {SITE.openTo && <span class="badge"><span class="dot" aria-hidden="true"></span>{SITE.openTo}</span>}
      {SITE.location && <span class="muted">📍 {SITE.location}</span>}
    </p>
    <SocialLinks>
      {SITE.hasCV && <a class="btn primary" href={url('cv.pdf')}>Download CV</a>}
    </SocialLinks>
  </section>

  <section>
    <h2>Featured projects</h2>
    <ProjectGrid projects={projects} />
    <p class="more"><a href={url('projects')}>All projects →</a></p>
  </section>

  <InTheLab />

  <section>
    <h2>Recent writing</h2>
    <PostList posts={posts} />
    <p class="more"><a href={url('blog')}>All posts →</a></p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 4rem 0 1rem; }
  .prompt { color: var(--muted); margin: 0 0 .5rem; }
  .prompt span { color: var(--accent); }
  h1 { font-size: clamp(2rem, 6vw, 2.75rem); }
  .lead { font-size: 1.1rem; color: var(--muted); max-width: 38rem; }
  .lead strong { color: var(--fg); }
  .tagline { color: var(--accent); margin: 0 0 1rem; }
  .meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; }
  .badge { display: inline-flex; align-items: center; gap: .45rem; padding: .3rem .65rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .dot { flex-shrink: 0; width: .5rem; height: .5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .more { margin-top: 1rem; font-size: .95rem; }
</style>
