---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import { getPosts, url } from '@/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <header class="page-head">
    <a class="small mono" href={url('blog')}>← All posts</a>
    <h1>#{tag}</h1>
  </header>
  <PostList {posts} />
</BaseLayout>
