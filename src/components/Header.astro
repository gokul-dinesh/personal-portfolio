---
import { NAV, SITE } from '@/config';
import { url } from '@/utils';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const isActive = (href: string) => {
  const path = `/${href.replace(/\/$/, '')}`;
  return current === path || current.startsWith(`${path}/`);
};
---
<header class="site-header">
  <nav class="container" aria-label="Main">
    <a class="brand mono" href={url()}>~/{SITE.name.split(' ')[0].toLowerCase()}<span class="cursor">_</span></a>
    <ul>
      {NAV.map((item) => (
        <li><a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--border); position: sticky; top: 0; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); z-index: 5; }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; flex-wrap: wrap; }
  .brand { color: var(--fg); text-decoration: none; font-weight: 600; }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  ul { display: flex; align-items: center; gap: 1.1rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  ul a { color: var(--muted); text-decoration: none; font-size: .95rem; }
  ul a:hover, ul a[aria-current='page'] { color: var(--fg); }
  ul a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
</style>
