---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
---
<div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
{projects.length === 0 && <p class="muted">Nothing here yet.</p>}
<style>.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }</style>
